---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmbeddingAnims from '../../components/EmbeddingAnims.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | Faycal Amrouche`} description={post.data.description}>
    <article class="prose">
        <header class="entry-meta" style="margin-bottom:1.5rem">
            <span class="role-line">{post.data.title}</span>
            <span class="date">{post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </header>
        <Content />
    </article>
    <EmbeddingAnims />
</Base>
